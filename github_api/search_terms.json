{
    "CycloneDX": 
    {
        "json":
        {
            "keywords":
            {
                "required": 
                [
                    "bomFormat",
                    "CycloneDX",
                    "specVersion"
                ],
                "optional": 
                [
                    "vulnerabilities"
                ]
            },
            "extentions": 
            [
                "json"
            ]
        },
        "xml":
        {
            "required":
            [
                "bom",
                "http://cyclonedx.org/schema/bom/",

            ],
            "optional":
            [
                "vulnerabilities", # Details vulnerabilities
                "vulnerability",
                    "bomReferenceType" # For when we want to refer to a VEX outside of the SBOM
                    "vulnerabilitiesType" # Acctual vulnerability?
                "vulnerabilityType" # ?
                "impactAnalysisStateType"
            ]
        }
    },
    "OpenVEX" : 
    {
        "json": 
        {
            "keywords": 
            [
                "@context", 
                "openvex", 
                "author", 
                "@id", 
                "statements", 
                "timestamp"
            ]
        }
    }
}